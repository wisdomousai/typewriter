{
  "name": "typewriter",
  "private": true,
  "type": "module",
  "description": "Robot machines in the browser: a typewriter whose every key, typebar, spring and bell move live in three.js, a teleprinter that prints telegrams on endless paper, and a chat where each person types on their own.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisdomousai/typewriter.git"
  },
  "homepage": "https://wisdomousai.github.io/typewriter/",
  "exports": {
    "./typewriter": "./src/typewriter/typewriter.ts",
    "./desk": "./src/typewriter/desk.ts",
    "./layouts": "./src/typewriter/layouts.ts",
    "./looks": "./src/typewriter/looks.ts",
    "./teleprinter": "./src/teleprinter/teleprinter.ts",
    "./telegram": "./src/teleprinter/telegram.ts",
    "./chat": "./src/chat/chat.ts",
    "./models/*": "./public/models/*",
    "./desk.css": "./src/components/desk.css",
    "./pass": "./src/chat/pass.ts",
    "./protocol": "./src/chat/protocol.ts"
  },
  "files": [
    "src/typewriter",
    "src/teleprinter",
    "src/chat",
    "src/components",
    "public/models",
    "README.md",
    "LICENSE",
    "chat"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "model": "blender/build.sh",
    "chat": "wrangler dev --config chat/wrangler.jsonc",
    "chat:deploy": "wrangler deploy --config chat/wrangler.jsonc",
    "chat:check": "tsc -p chat"
  },
  "dependencies": {
    "@fontsource/maple-mono": "^5.3.0"
  },
  "peerDependencies": {
    "three": ">=0.180.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@fontsource/maple-mono": "^5.3.0",
    "@types/three": "^0.186.0",
    "astro": "^7.3.8",
    "three": "^0.186.1",
    "typescript": "^6.0.2",
    "wrangler": "^4.149.0"
  }
}
